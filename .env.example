# AI Safety System Design - Environment Variables
# Copy this file to .env and fill in your values

# Flask Secret Key (REQUIRED for production)
# Generate a secure key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here

# Standalone Mode (default: true)
# Set to 'false' if running with parent orchestrator
STANDALONE=true

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=1

# Admin Authentication Token (REQUIRED for admin panel access)
# Generate a secure token with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=your-admin-token-here

# WORM USB Configuration (optional)
# WORM_USB_PATH=/path/to/worm/usb

# Simulation Data Path (optional)
# SIMULATION_DATA_PATH=/path/to/simulation/data

# Logging Configuration
LOG_LEVEL=INFO
